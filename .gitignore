# Secrets — never commit
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# OS / editor
.DS_Store
.idea/
.vscode/

# Docs — only README.md is tracked on GitHub
*.md
!README.md
!experiments/results/summary.md

# Optional: local demo trace JSON (remove these 3 lines if you want traces in the repo)
data/traces/*.json
!data/traces/.gitkeep
