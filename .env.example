# ResQFlow backend — copy this file to .env and fill your key
# Location: disaster_response/.env  (same folder as this file)
# Frontend never reads this file; only disaster_response/backend/ does.

LLM_PROVIDER=aicredits
PORT=8000

# AICredits (OpenAI-compatible) — recommended for this project
AICREDITS_API_KEY=
AICREDITS_BASE_URL=https://api.aicredits.in/v1
# gpt-4o-mini: fast, cheap, good for briefing/report text
AICREDITS_MODEL=gpt-4o-mini

# Direct OpenAI (optional alternative)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Other providers (optional)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001
